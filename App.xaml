<Application x:Class="skovbyprojekt.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:skovbyprojekt"
             xmlns:viewmodel="clr-namespace:skovbyprojekt.ViewModels"
             xmlns:view="clr-namespace:skovbyprojekt.Views"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>

        <DataTemplate DataType="{x:Type viewmodel:CreateActivityViewModel}">
            <view:CreateActivityView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodel:CreateTrainingPlanViewModel}">
            <view:CreateTrainingPlanView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodel:CreateManualTrainingPlanViewModel}">
            <view:CreateManualTrainingPlanView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodel:CreateTeamViewModel}">
            <view:CreateTeamView/>
        </DataTemplate>

        <Style TargetType="Button">
            <Setter Property = "Background" Value = "#eb5757" />
            <Setter Property = "Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF374864"/>
                    <Setter Property="Foreground" Value="#FF374864"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
    </Application.Resources>
</Application>
