<UserControl x:Class="skovbyprojekt.Views.CreateManualTrainingPlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:skovbyprojekt.Views"
             mc:Ignorable="d" 
             Height="490" 
             Width="840"
             Background="#6495ED"
             FontFamily="Arial"
             FontWeight="Bold">
    <Grid RenderTransformOrigin="0.339,1.338">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="125"/>
            <ColumnDefinition Width="125"/>
            <ColumnDefinition Width="125"/>
            <ColumnDefinition Width="125"/>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="20"/>
        </Grid.ColumnDefinitions>


        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>


        <Label
            x:Name="CreateManualTrainingPlan"
            Content="Opret Manuel Træningsplan"
            Height="90"
            Width="705"
            Grid.Row="0"
            Grid.ColumnSpan="6"
            Grid.RowSpan="3"
            HorizontalAlignment="Left"
            FontSize="52" Margin="67,15,0,30"
          />

        <Label 
            x:Name="ChooseTeam"
            Content="*_Vælg Hold"
            Grid.Column="2" 
            FontSize="16"
            HorizontalAlignment="Left" 
            Grid.Row="2" 
            VerticalAlignment="Top" 
            Width="230" 
            Grid.ColumnSpan="2" Margin="20,15,0,0"
            Target="{Binding ElementName=CBTeam}"
            />

        <ComboBox 
            x:Name="CBTeam"
            Grid.Column="2" 
            Grid.ColumnSpan="3" 
            HorizontalAlignment="Left" 
            Margin="15,3,0,0" 
            Grid.Row="3" 
            VerticalAlignment="Top" 
            Width="240" 
            Height="45" 
            Grid.RowSpan="2"/>

        <Label
            x:Name="AllActivitys"
            Content="Alle aktiviteter:"
            Grid.Column="0"
            Grid.Row="4"
            Width="230"
            Height="28"
            Margin="28,10,17,7"
            FontSize="16" Grid.ColumnSpan="2"
            />

        <ListBox 
            Grid.Row="5" 
            d:ItemsSource="{d:SampleData ItemCount=5}" 
            Margin="28,0,2,-30" 
            Grid.ColumnSpan="3" 
            Grid.RowSpan="5"
            Width="370"/>

        <Label
            x:Name="SelectedActivitys"
            Content="Valgte aktiviteter:"
            Grid.Column="3"
            Grid.Row="4"
            Width="230"
            Height="28"
            Margin="42,10,108,7"
            FontSize="16" 
            Grid.ColumnSpan="3"
            />

        <ListBox 
            Grid.Row="5" 
            d:ItemsSource="{d:SampleData ItemCount=5}" 
            Margin="42,0,-17,0" 
            Grid.Column="3"
            Grid.ColumnSpan="4" 
            Grid.RowSpan="4"/>

        <Button 
            Grid.Column="3"             
            HorizontalAlignment="Left"
            Margin="69,4,0,0" 
            Height="25"
            Width="161"
            Grid.Row="10" 
            VerticalAlignment="Top"
            FontSize="16"
            Background="#EDBB64" Grid.ColumnSpan="2">
            <AccessText>_Ryd</AccessText>
        </Button>

        <Button 
            Grid.Column="5" 
            HorizontalAlignment="Center" 
            Margin="0,4,0,0" 
            Grid.Row="10"
            Height="25"
            Width="130"
            VerticalAlignment="Top"
            FontSize="16"
            Background="#EDBB64">
            <AccessText>G_em</AccessText>
        </Button>

    </Grid>

</UserControl>
