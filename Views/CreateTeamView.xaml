<UserControl x:Class="skovbyprojekt.Views.CreateTeamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:skovbyprojekt.Views"
             mc:Ignorable="d" 
             Height="490" 
             Width="840"
             Background="#6495ED"
             FontFamily="Arial"
             FontWeight="Bold">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="125"/>
            <ColumnDefinition Width="125"/>
            <ColumnDefinition Width="125"/>
            <ColumnDefinition Width="125"/>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="20"/>
        </Grid.ColumnDefinitions>


        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>


        <Label
            x:Name="CreateTeam"
            Content="Opret hold"
            Height="90"
            Width="500"
            Grid.Column="2"
            Grid.Row="0"
            Grid.ColumnSpan="4"
            Grid.RowSpan="3"
            HorizontalAlignment="Center"
            FontSize="52"
          />

        <Label 
            x:Name="EnterATeamName"
            Content="*_Angiv navn på holdet:"
            Grid.Column="2" 
            FontSize="16"
            HorizontalAlignment="Left" 
            Grid.Row="3" 
            VerticalAlignment="Center" 
            Width="230" 
            Grid.ColumnSpan="2" Margin="20,0,0,0"
            Target="{Binding ElementName=EnterTeamName}"
            />

        <TextBox 
            x:Name="EnterTeamName" 
            Grid.Column="2" 
            Grid.ColumnSpan="3" 
            HorizontalAlignment="Left" 
            Grid.Row="4" 
            TextWrapping="Wrap" 
            VerticalAlignment="Top" 
            Width="250" 
            Height="38" Margin="20,0,0,0"/>

        <Button 
            Grid.Column="4"
            HorizontalAlignment="Center" 
            Grid.Row="9" 
            VerticalAlignment="Center"
            Height="25"
            Width="125"
            FontSize="16"
            Background="#EDBB64">
            <AccessText>G_em hold</AccessText>
        </Button>

        <Button 
            Grid.Column="5"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Center" 
            Grid.Row="9" 
            VerticalAlignment="Center"
            Height="25"
            Width="130"
            FontSize="16"
            Background="#EDBB64">
            <AccessText>Opret _nyt hold</AccessText>
        </Button>




    </Grid>

</UserControl>

