<UserControl x:Class="skovbyprojekt.Views.CreateActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:skovbyprojekt.Views"
             mc:Ignorable="d" 
             Height="490" 
             Width="840"
             Background="#6495ED"
             FontFamily="Arial"
             FontWeight="Bold">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="500"/>
            <ColumnDefinition Width="20"/>
        </Grid.ColumnDefinitions>


        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>


        <Label
            x:Name="Headline"
            Content="Opret træningsktivitet"
            Height="90"
            Width="550"
            Grid.Column="0"
            Grid.Row="0"
            Grid.ColumnSpan="5"
            Grid.RowSpan="3"
            HorizontalAlignment="Center"
            FontSize="52"
            
            />


        <Label
            x:Name="EnterActivityName"
            Content="*_Angiv navn på aktiviteten:"
            Height="40"
            Width="250"
            Grid.Column="1"
            Grid.Row="3"
            FontSize="16"
            Target="{Binding ElementName=Activitytxt}"
            />

        <TextBox
            x:Name="Activitytxt"
            Width="250"
            Grid.Column="1"
            Grid.Row="4"
            Background="White"
            FontSize="14" Margin="0,0,0,3" Text="{Binding Name}"
            />

        <Label
            x:Name="EnterType"
            Content="*Type (flere kan vælges):"
            Height="40"
            Width="330"
            Grid.Column="1"
            Grid.Row="6"
            FontSize="16"
            />

        <StackPanel 
            Grid.Column="1"
            Grid.Row="7" 
            Grid.RowSpan="2" 
            Width="200" 
            Height="60">
            <CheckBox Content="O_pvarmnning" FontSize="16"/>
            <CheckBox Content="Spo_rt" FontSize="16"/>
            <CheckBox Content="_Nedkøling" FontSize="16"/>
        </StackPanel>

        <Label
            x:Name="EnterTools"
            Content="Angiv redskaber t_il aktiviteten:"
            Height="40"
            Width="330"
            Grid.Column="1"
            Grid.Row="9"
            FontSize="16"
            Target="{Binding ElementName=Toolstxt}"
            />

        <TextBox
            x:Name="Toolstxt"
            Width="250"
            Grid.Column="1"
            Grid.Row="10"
            Grid.RowSpan="3"
            Background="White"
            FontSize="14"
            AcceptsReturn="True"
            TextWrapping="Wrap" Margin="0,5,0,15"
            />

        <Label
            x:Name="EnterDescription"
            Content="Tilføj _beskrivelse af aktivitet:"
            Height="35"
            Width="500"
            Grid.Column="3"
            Grid.Row="3"
            FontSize="16"
            Target="{Binding ElementName=Descriptiontxt}"
            />

        <TextBox
            Height="70"
            x:Name="Descriptiontxt"
            Width="500"
            Grid.Column="3"
            Grid.Row="4"
            Grid.RowSpan="2"
            Background="White"
            FontSize="14"
            AcceptsReturn="True"
            TextWrapping="Wrap"
                />

        <Label
            x:Name="EnterRules"
            Content="R_egler:"
            Width="500"
            Grid.Column="3"
            Grid.Row="6"
            FontSize="16"
            Target="{Binding ElementName=Rulestxt}"
            />

        <TextBox
            x:Name="Rulestxt"
            Width="500"
            Grid.Column="3"
            Grid.Row="7"
            Grid.RowSpan="6"
            Background="White"
            FontSize="14"
            AcceptsReturn="True"
            TextWrapping="Wrap" Margin="0,0,0,15"
            />

        <Button 
            Grid.Column="3"
            HorizontalAlignment="Left"
            Margin="200,0,0,0" 
            Height="25"
            Width="160"
            Grid.Row="13" 
            VerticalAlignment="Center"
            FontSize="16"
            Background="#EDBB64">
            <AccessText>R_yd</AccessText>
        </Button>


        <Button 
            Grid.Column="3"              
            HorizontalAlignment="Left" 
            Margin="371,0,0,0" 
            Grid.Row="13"
            Height="25"
            Width="130"
            VerticalAlignment="Center"
            FontSize="16"
            Background="#EDBB64">
            <AccessText>Ge_m</AccessText>
        </Button>


    </Grid>
</UserControl>
